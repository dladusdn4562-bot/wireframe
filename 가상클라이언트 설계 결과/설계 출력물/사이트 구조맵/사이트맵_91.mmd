graph TD
    %% [SEUMIM Total IA System - Bodyluv Product Story Dedicated Model]
    classDef root fill:#1b382b,stroke:#0f2219,stroke-width:3px,color:#ffffff,font-weight:bold,font-size:16px;
    classDef branch fill:#eef4f0,stroke:#2d5a43,stroke-width:2px,color:#1b382b,font-weight:bold,font-size:14px;
    classDef lineStory fill:#fdfbf7,stroke:#d97736,stroke-width:2px,color:#9c4310,font-weight:bold,font-size:13px;
    classDef leaf fill:#ffffff,stroke:#cfded5,stroke-width:1px,color:#2c3e50,font-size:12px;
    classDef highlight fill:#d97736,stroke:#9c4310,stroke-width:2px,color:#ffffff,font-weight:bold,font-size:13px;

    ROOT["SEUMIM 브랜드 소개 페이지 (Our Story)<br>[바디럽 상품별 독립 스토리 롤모델]"]:::root

    %% 1. GNB & Tab Bar
    GNB["1.0 GNB & 앵커 탭 바"]:::branch
    ROOT --> GNB
    GNB --> G1["1.1 스밈 0.1mm 로고 & 홈 링크"]:::leaf
    GNB --> G2["1.2 글로벌 GNB (홈/대표작/전체28/AI센터/Our Story)"]:::leaf
    GNB --> G3["1.3 유틸리티 (하트 찜 / 토트백 장바구니 / 0원 시착)"]:::leaf
    GNB --> G4["1.4 스토리 앵커 탭 (전체 / 코어웨어 / 척추정렬 / 골반 / 테크ACC)"]:::highlight

    %% 2. Brand Intro
    INTRO["2.0 브랜드 안녕(安寧) 매니페스토"]:::branch
    ROOT --> INTRO
    INTRO --> I1["2.1 안녕(安寧) : 아무 탈 없이 편안함"]:::leaf
    INTRO --> I2["2.2 바디럽형 결정적 질문 (왜 통증을 참아야 할까?)"]:::leaf
    INTRO --> I3["2.3 Effortless Wellness 스밈의 존재 이유"]:::leaf

    %% 3. Product Line Stories
    STORIES["3.0 4대 상품 라인별 독자적 탄생 서사"]:::branch
    ROOT --> STORIES

    STORIES --> L1["3.1 Line 01. 0.1mm 심리스 코어웨어 스토리"]:::lineStory
    L1 --> L1_1["[문제] 숨 막히는 보정기와 와이어의 고통"]:::leaf
    L1 --> L1_2["[R&D] 엔지니어들의 3년 450회 원사 배합 실험"]:::leaf
    L1 --> L1_3["[에셋] VIS-01 나노 전도성 섬유 450배 스캔 컷"]:::leaf
    L1 --> L1_4["[대표작] 0.1mm 넥&숄더 밴드 3D 인터랙션 & 0원 시착"]:::highlight

    STORIES --> L2["3.2 Line 02. 3D 에어로 메쉬 척추 정렬 조끼 스토리"]:::lineStory
    L2 --> L2_1["[문제] 장시간 착석 직장인의 굽은 등과 땀 차는 흉통"]:::leaf
    L2 --> L2_2["[R&D] 척추 기립근 탄성 지렛대 프레임 & 쿨링 공학"]:::leaf
    L2 --> L2_3["[에셋] VIS-02 척추 프레임 단면도 & 열화상 쿨링 컷"]:::leaf
    L2 --> L2_4["[대표작] 3D 에어로 척추 조끼 3D 작동 원리 & 0원 시착"]:::highlight

    STORIES --> L3["3.3 Line 03. 인체공학 에어셀 골반 밸런스 벨트 스토리"]:::lineStory
    L3 --> L3_1["[문제] 무의식적 다리 꼬기 습관과 골반 비대칭"]:::leaf
    L3 --> L3_2["[R&D] 착석 체압 감지 반사 패드 & 물리 차단 공학"]:::leaf
    L3 --> L3_3["[에셋] VIS-03 착석 체압 비대칭 감지 시뮬레이션"]:::leaf
    L3 --> L3_4["[대표작] 골반 에어셀 벨트 3D 체압 분산도 & 0원 시착"]:::highlight

    STORIES --> L4["3.4 Line 04. 스마트 햅틱 센서 & 직업 맞춤 ACC 스토리"]:::lineStory
    L4 --> L4_1["[문제] 내 자세가 언제 어떻게 무너지는지 알 수 없음"]:::leaf
    L4 --> L4_2["[R&D] 0.01초 시차 필터링 모션 센싱 + 직업별 맞춤 도구"]:::leaf
    L4 --> L4_3["[에셋] VIS-04 0.01초 모션 센싱 파형 & 300인 포토"]:::leaf
    L4 --> L4_4["[대표작] 스마트 햅틱 센서 & 직업 맞춤 ACC 7종"]:::highlight

    %% 4. Social Proof
    PROOF["4.0 사회적 검증 & 친환경 비전"]:::branch
    ROOT --> PROOF
    PROOF --> P1["4.1 300인 의사·개발자 실착 검증 (통증 87.4% 감소)"]:::leaf
    PROOF --> P2["4.2 100% 생분해성 리사이클 원사 & 글로벌 웰니스 비전"]:::leaf

    %% 5. Showcase & CTA
    CONV["5.0 28종 쇼케이스 & 0원 무료 시착"]:::branch
    ROOT --> CONV
    CONV --> C1["5.1 4대 카테고리 28개 전 상품 퀵 탐색 탭"]:::leaf
    CONV --> C2["5.2 [스밈 3대 대표작 3D 체험하기 ➔] 메인 복귀 배너"]:::leaf
    CONV --> C3["5.3 [30일 무료 시착 (결제 0원)] & 100% 안심 무료 반품 바"]:::highlight
