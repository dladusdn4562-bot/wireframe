flowchart TD
    %% 노드 스타일 정의
    classDef main fill:#1E293B,stroke:#0F172A,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef depth1 fill:#0284C7,stroke:#0369A1,stroke-width:2px,color:#FFFFFF;
    classDef depth2 fill:#38BDF8,stroke:#0284C7,stroke-width:1px,color:#0F172A;
    classDef modal fill:#F59E0B,stroke:#D97706,stroke-width:1px,color:#0F172A;
    classDef assumed fill:#64748B,stroke:#475569,stroke-width:1px,color:#FFFFFF,stroke-dasharray: 5 5;

    %% 메인페이지
    MAIN["0.0 메인 랜딩페이지 (P-0.0)"]:::main

    %% 1차 메뉴 (GNB)
    BRAND["1.0 브랜드 스토리 (P-1.0)"]:::depth1
    PRODUCT["2.0 시그니처 HW (P-2.0)"]:::depth1
    AIDATA["3.0 AI 데이터 케어 (P-3.0)"]:::depth1
    O2O["4.0 오프라인 동행센터 (P-4.0)"]:::depth1
    OFFER["5.0 혜택 & 체험 (P-5.0)"]:::depth1
    MYPAGE["6.0 회원 서비스 [가정] (P-6.0)"]:::assumed
    EXCEPT["9.0 예외 페이지 [가정] (P-9.0)"]:::assumed

    MAIN --> BRAND
    MAIN --> PRODUCT
    MAIN --> AIDATA
    MAIN --> O2O
    MAIN --> OFFER
    MAIN -.-> MYPAGE
    MAIN -.-> EXCEPT

    %% 브랜드 하위
    BRAND --> B1["1.1 브랜드 철학"]:::depth2
    BRAND --> B2["1.2 척추 질환 통계"]:::depth2
    BRAND --> B3["1.3 3대 원천 기술"]:::depth2

    %% 하드웨어 하위
    PRODUCT --> P1["2.1 어깨 & 거북목 밴드"]:::depth2
    PRODUCT --> P2["2.2 스마트 척추 조끼"]:::depth2
    PRODUCT --> P3["2.3 골반 에어셀 벨트"]:::depth2
    PRODUCT --> P4["2.4 정밀 사이즈 가이드 [모달]"]:::modal

    %% AI 데이터 하위
    AIDATA --> A1["3.1 다크모드 대시보드"]:::depth2
    AIDATA --> A2["3.2 스마트워치 퀵-글랜스 UI"]:::depth2
    AIDATA --> A3["3.3 10초 AI 미니멀 케어"]:::depth2

    %% O2O 동행센터 하위
    O2O --> O1["4.1 위치 기반 지도 검색"]:::depth2
    O2O --> O2["4.2 1회 무료 체험 4단계 예약 [모달]"]:::modal
    O2 --> O3["4.3 예약 완료 안내 [가정]"]:::assumed

    %% 혜택 및 체험 하위
    OFFER --> F1["5.1 직장인/테크 찐후기"]:::depth2
    OFFER --> F2["5.2 30일 무료 체험 신청 [모달]"]:::modal
    OFFER --> F3["5.3 FAQ 아코디언"]:::depth2

    %% 회원 서비스 하위 [가정]
    MYPAGE -.-> M1["6.1 로그인/회원가입 [가정]"]:::assumed
    MYPAGE -.-> M2["6.2 마이페이지 [가정]"]:::assumed

    %% 예외 페이지 [가정]
    EXCEPT -.-> E1["9.1 404 Not Found [가정]"]:::assumed
    EXCEPT -.-> E2["9.2 시스템 점검 안내 [가정]"]:::assumed

    %% 주요 사용자 여정 (User Journey Links)
    P4 --> F2
    O2 --> O3
    F2 --> MAIN
